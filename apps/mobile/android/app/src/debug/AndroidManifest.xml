<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application android:usesCleartextTraffic="true" tools:targetApi="28"
        tools:ignore="GoogleAppIndexingWarning" tools:replace="android:usesCleartextTraffic">
        <!-- Distinguish this side-by-side service from QA/release variants in Android Settings. -->
        <service android:name=".ScreenAssistService"
            android:label="${screenAssistServiceLabel}"
            tools:replace="android:label" />
        <service android:name=".NexaLauncherNavigationService"
            android:label="${launcherNavigationServiceLabel}"
            tools:replace="android:label" />
        <!-- Native non-React foreground activity for emulator instrumentation.
             This is debug-only, nonexported and excluded from release APKs. -->
        <activity android:name=".NexaVoiceTestHostActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
