# Copy outside git and populate with secrets, never commit live .env.
AGENT_API_TOKEN=replace-with-32-or-more-random-characters
AGENT_LLM_API_KEY=replace-with-your-provider-key
AGENT_LLM_MODEL=your-structured-output-compatible-model
# Optional provider endpoint. Must be HTTPS or loopback.
# AGENT_LLM_BASE_URL=https://your-provider.example/v1
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8741
